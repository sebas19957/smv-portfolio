---
// Applies the saved theme before first paint (no light/dark flash). Key must match theme.ts.
---

<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
</script>
