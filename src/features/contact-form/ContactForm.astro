---
import type { ContactCopy } from '../../i18n';
import Button from '../../shared/ui/Button.astro';

interface Props {
  form: ContactCopy['form'];
}

const { form } = Astro.props;
const fields = [
  {
    name: 'name',
    type: 'text',
    label: form.nameLabel,
    placeholder: form.namePlaceholder,
    error: form.errors.name,
    autocomplete: 'name',
    minlength: 3,
  },
  {
    name: 'email',
    type: 'email',
    label: form.emailLabel,
    placeholder: form.emailPlaceholder,
    error: form.errors.email,
    autocomplete: 'email',
    minlength: undefined,
  },
] as const;
---

<form class="contact-form" novalidate data-contact-form>
  <div class="contact-form__row">
    {
      fields.map((field) => (
        <label class="field">
          <span class="hud-label field__label">{field.label}</span>
          <input
            class="field__control"
            type={field.type}
            name={field.name}
            placeholder={field.placeholder}
            autocomplete={field.autocomplete}
            minlength={field.minlength}
            required
            aria-describedby={`contact-${field.name}-error`}
          />
          <span id={`contact-${field.name}-error`} class="hud-label field__error" hidden data-field-error={field.name}>
            {field.error}
          </span>
        </label>
      ))
    }
  </div>
  <label class="field">
    <span class="hud-label field__label">{form.messageLabel}</span>
    <textarea
      class="field__control field__control--area"
      name="message"
      rows="6"
      placeholder={form.messagePlaceholder}
      minlength="10"
      required
      aria-describedby="contact-message-error"></textarea>
    <span id="contact-message-error" class="hud-label field__error" hidden data-field-error="message">
      {form.errors.message}
    </span>
  </label>
  <div class="contact-form__actions">
    <Button type="submit" variant="primary" size="lg" icon="send">{form.submit}</Button>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form__row {
    display: grid;
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    color: var(--faint);
  }

  .field__control {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 120ms linear;
  }

  .field__control--area {
    height: auto;
    min-height: 168px;
    padding-block: 12px;
    line-height: 1.625;
  }

  .field__control:hover {
    border-color: var(--line-strong);
  }

  .field__control:focus-visible {
    border-color: var(--ink);
    outline-offset: 0;
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .field__error {
    color: var(--danger);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  @media (min-width: 40rem) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
