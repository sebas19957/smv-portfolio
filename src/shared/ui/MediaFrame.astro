---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio of the frame (e.g. "4 / 5"). */
  aspect?: string;
  /** Responsive `sizes` hint for the generated srcset. */
  sizes: string;
  widths: number[];
  /** Above-the-fold media loads eagerly with high priority. */
  priority?: boolean;
  position?: string;
  class?: string;
}

const {
  image,
  alt,
  aspect = '4 / 5',
  sizes,
  widths,
  priority = false,
  position = 'center',
  class: className,
} = Astro.props;
---

<div class:list={['media-frame', className]} style={`--frame-aspect: ${aspect}; --frame-position: ${position};`}>
  <Picture
    src={image}
    alt={alt}
    widths={widths}
    width={Math.max(...widths)}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={78}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="media-frame__img"
  />
  <span class="media-frame__mark media-frame__mark--tl" aria-hidden="true"></span>
  <span class="media-frame__mark media-frame__mark--tr" aria-hidden="true"></span>
  <span class="media-frame__mark media-frame__mark--bl" aria-hidden="true"></span>
  <span class="media-frame__mark media-frame__mark--br" aria-hidden="true"></span>
  <slot />
</div>

<style>
  /* Sunken media well with a hairline border and blueprint crosshairs on each corner. */
  .media-frame {
    position: relative;
    aspect-ratio: var(--frame-aspect);
    border: 1px solid var(--line);
    background: var(--bg-sunken);
  }

  .media-frame :global(picture) {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .media-frame :global(.media-frame__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--frame-position);
  }

  .media-frame__mark {
    position: absolute;
    z-index: 2;
    width: 11px;
    height: 11px;
    pointer-events: none;
  }

  .media-frame__mark::before,
  .media-frame__mark::after {
    content: '';
    position: absolute;
    background: var(--line-strong);
  }

  .media-frame__mark::before {
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .media-frame__mark::after {
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
  }

  .media-frame__mark--tl { top: -6px; left: -6px; }
  .media-frame__mark--tr { top: -6px; right: -6px; }
  .media-frame__mark--bl { bottom: -6px; left: -6px; }
  .media-frame__mark--br { bottom: -6px; right: -6px; }
</style>
