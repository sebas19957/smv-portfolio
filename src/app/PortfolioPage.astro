---
/**
 * Page container: resolves the locale's content once and hands typed slices to the
 * presentational sections. All client behaviour boots from `client.ts`.
 */
import ProjectSheet from '../features/project-sheet/ProjectSheet.astro';
import ScrollRail from '../features/scroll-rail/ScrollRail.astro';
import SiteNav from '../features/navigation/SiteNav.astro';
import { getContent, sectionIndex, toUpper, type Locale } from '../i18n';
import AboutSection from '../sections/about/AboutSection.astro';
import ContactSection from '../sections/contact/ContactSection.astro';
import SiteFooter from '../sections/footer/SiteFooter.astro';
import HeroSection from '../sections/hero/HeroSection.astro';
import PhilosophySection from '../sections/philosophy/PhilosophySection.astro';
import ProjectsSection from '../sections/projects/ProjectsSection.astro';
import ResumeSection from '../sections/resume/ResumeSection.astro';
import SkillsSection from '../sections/skills/SkillsSection.astro';
import TestimonialsSection from '../sections/testimonials/TestimonialsSection.astro';
import BaseLayout from './BaseLayout.astro';
import { RAIL_GROUPS } from './rail-groups';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const { copy, profile } = content;
const railWords = RAIL_GROUPS.map((group) => ({
  id: group.sections[0],
  label: toUpper(copy.ui.nav[group.label], locale),
  members: group.sections,
}));
---

<BaseLayout locale={locale} meta={copy.meta}>
  <a class="skip-link hud-label" href="#main">{copy.ui.skipToContent}</a>
  <SiteNav locale={locale} ui={copy.ui} logo={profile.logo} brand={profile.brand} ctaLabel={copy.hero.ctaPrimary} />
  <main id="main">
    <HeroSection content={content} />
    <AboutSection content={content} />
    <SkillsSection content={content} />
    <ResumeSection content={content} />
    <ProjectsSection content={content} />
    <TestimonialsSection content={content} />
    <PhilosophySection content={content} />
    <ContactSection content={content} />
  </main>
  <SiteFooter content={content} />
  <ProjectSheet
    sectionIndex={sectionIndex('projects')}
    sectionLabel={copy.ui.nav.projects}
    closeLabel={copy.projects.detail.close}
    previousLabel={copy.projects.detail.previousImage}
    nextLabel={copy.projects.detail.nextImage}
  />
  <ScrollRail
    words={railWords}
    label={copy.ui.railLabel}
    jumpTo={copy.ui.railJumpTo}
    sectionsLabel={copy.ui.railSectionsLabel}
  />
</BaseLayout>

<script>
  import { bootClient } from './client';
  bootClient();
</script>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--invert-bg);
    color: var(--invert-fg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
