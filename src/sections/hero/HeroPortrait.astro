---
/**
 * Free-standing hero figure: the background-removed cutout stands on the hero's bottom hairline
 * (its cropped shirt edge flush with the line), with a compact frosted status card floating over
 * the lower part of the figure.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  statusLabel: string;
  statusValue: string;
  experienceLabel: string;
  experienceValue: string;
}

const { image, alt, statusLabel, statusValue, experienceLabel, experienceValue } = Astro.props;
// Never upscale: candidate widths stop at the source width.
const widths = [...new Set([300, 360, 420, 540, 720, 840].filter((w) => w < image.width).concat(image.width))];
---

<figure class="figure" data-reveal>
  <Picture
    src={image}
    alt={alt}
    widths={widths}
    width={image.width}
    sizes="(min-width: 1440px) 400px, (min-width: 1024px) 28vw, min(360px, calc(100vw - 48px))"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={82}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="figure__img"
  />
  <figcaption class="hairline-grid figure__card">
    <span class="figure__stat">
      <span class="hud-label text-faint">{statusLabel}</span>
      <span class="font-display figure__value">
        {statusValue}<span class="figure__lamp" aria-hidden="true"></span>
      </span>
    </span>
    <span class="figure__stat">
      <span class="hud-label text-faint">{experienceLabel}</span>
      <span class="font-display figure__value">{experienceValue}</span>
    </span>
  </figcaption>
</figure>

<style>
  /*
   * Stacked layouts: the figure closes the hero column and stands on the section's bottom line
   * (the hero drops its bottom padding below 1024px, see HeroSection).
   */
  .figure {
    position: relative;
    width: min(360px, 100%);
    margin-inline: auto;
  }

  .figure :global(picture) {
    display: block;
  }

  .figure :global(.figure__img) {
    display: block;
    width: 100%;
    height: auto;
    /* The source crops the arms at its side edges: feather those cuts so the figure reads free-standing. */
    mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  /* Compact floating card in the reference idiom: hairline frame over a frosted fill. */
  .figure__card {
    position: absolute;
    left: -12px;
    bottom: 20px;
    grid-template-columns: auto auto;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .figure__card > .figure__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px);
  }

  .figure__value {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
    white-space: nowrap;
  }

  .figure__lamp {
    width: 7px;
    height: 7px;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  /*
   * Side by side from 1024px: the figure is pinned to the hero's bottom-right corner, its base on
   * the hairline that closes the section, rising beside the copy.
   */
  @media (min-width: 64rem) {
    .figure {
      position: absolute;
      right: 40px;
      bottom: 0;
      width: clamp(280px, 28vw, 400px);
      margin: 0;
    }

    /* Narrow side-by-side widths: keep the card over the figure, clear of the copy column. */
    .figure__card {
      left: auto;
      right: 0;
      bottom: 28px;
    }
  }

  @media (min-width: 80rem) {
    .figure__card {
      left: -40px;
      right: auto;
    }
  }
</style>
