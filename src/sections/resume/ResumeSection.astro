---
import { pad2, sectionIndex, type PortfolioContent } from '../../i18n';
import RichText from '../../shared/ui/RichText.astro';
import { SECTION_ACCENTS } from '../section-accents';
import Section from '../../shared/ui/Section.astro';
import SubBar from '../../shared/ui/SubBar.astro';
import EducationCell from './EducationCell.astro';
import ExperienceRow from './ExperienceRow.astro';

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const { copy, profile } = content;
const { resume, ui } = copy;

const experience = profile.experience.flatMap((fact) => {
  const entry = resume.experience.find((item) => item.id === fact.id);
  return entry ? [{ fact, entry }] : [];
});
---

<Section
  id="resume"
  index={sectionIndex('resume')}
  label={ui.nav.resume}
  aside={`${resume.workHeading} · ${resume.educationHeading}`}
>
  <div class="section-pad">
    <h2 class="heading-xl" data-reveal><RichText text={resume.heading} accent={SECTION_ACCENTS.resume} /></h2>
    <p class="lead resume__lead" data-reveal>{resume.subtitle}</p>
  </div>

  <SubBar index={`${sectionIndex('resume')}.1`} label={resume.workHeading} aside={pad2(experience.length)} />
  <div class="resume__experience">
    {
      experience.map(({ fact, entry }, i) => (
        <ExperienceRow
          index={pad2(i + 1)}
          fact={fact}
          entry={entry}
          tasksLabel={resume.tasksLabel}
          achievementsLabel={resume.achievementsLabel}
          presentLabel={resume.presentLabel}
        />
      ))
    }
  </div>

  <SubBar index={`${sectionIndex('resume')}.2`} label={resume.educationHeading} aside={pad2(resume.education.length)} />
  <ol class="hairline-grid resume__education" data-reveal-group>
    {
      resume.education.map((item, i) => (
        <EducationCell index={pad2(i + 1)} item={item} categoryLabel={resume.educationCategories[item.category]} />
      ))
    }
  </ol>
</Section>

<style>
  .resume__lead {
    margin-top: 20px;
  }

  .resume__experience {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
  }

  @media (min-width: 48rem) {
    .resume__education {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
