---
import BrandLogo from '../../shared/ui/BrandLogo.astro';
import type { ResolvedIcon } from '../../shared/ui/brand-icons';

interface Props {
  index: string;
  /** Official mark of the skill, inlined at build time. */
  icon: ResolvedIcon;
  name: string;
  /** Proficiency, 0–100. */
  level: number;
  category: string;
  categoryLabel: string;
  accentClass: string;
}

const { index, icon, name, level, category, categoryLabel, accentClass } = Astro.props;

const readout = String(level).padStart(3, '0');
---

<li class:list={['skill cell-pad', accentClass]} data-reveal data-filter-tags={category}>
  <div class="skill__top">
    <span class="chip" data-tone="status">{categoryLabel}</span>
    <span class="hud-label text-faint">{index}</span>
  </div>
  <div class="skill__heading">
    <BrandLogo icon={icon} class="skill__logo" />
    <h3 class="title-feature skill__name">{name}</h3>
  </div>
  <div
    class="skill__meter"
    style={`--level: ${level / 100};`}
    role="meter"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={level}
    aria-label={name}
    data-skill-meter={level}
  >
    <span class="skill__scale" aria-hidden="true">
      <span class="skill__ticks"></span>
      <span class="skill__ticks skill__ticks--lit"></span>
      <span class="skill__fill"></span>
      <span class="skill__needle"></span>
    </span>
    <span class="skill__readout" aria-hidden="true"><span data-skill-readout>{readout}</span>%</span>
  </div>
</li>

<style>
  .skill {
    display: flex;
    flex-direction: column;
  }

  .skill__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Official full-colour logo beside the name, in a fixed slot centred on the first line. */
  .skill__heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 24px;
  }

  .skill__heading :global(.skill__logo) {
    margin-top: 1px;
    font-size: 22px;
  }

  .skill__name {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .skill__meter {
    --p: var(--level);
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin-top: auto;
    padding-top: 28px;
  }

  /*
   * A miniature of the page rail in the category colour: a 1px baseline with ticks every 5%
   * (major every 25%) hanging upward. Up to the level, a 3px solid fill runs along the baseline
   * and the ticks switch from faint to full ink, ending at the glowing needle.
   */
  .skill__scale {
    position: relative;
    flex: 1;
    height: 14px;
    background: linear-gradient(var(--line), var(--line)) 0 100% / 100% 1px no-repeat;
  }

  .skill__ticks {
    position: absolute;
    inset: 0 0 1px;
    --tick: color-mix(in srgb, var(--ink) 26%, transparent);
    background:
      linear-gradient(var(--tick), var(--tick)) 100% 100% / 1px 9px no-repeat,
      linear-gradient(to right, var(--tick) 1px, transparent 1px) 0 100% / 25% 9px repeat-x,
      linear-gradient(to right, var(--tick) 1px, transparent 1px) 0 100% / 5% 5px repeat-x;
  }

  .skill__ticks--lit {
    --tick: color-mix(in srgb, var(--ink) 88%, transparent);
    mask-image: linear-gradient(to right, #000 calc(var(--p) * 100%), transparent calc(var(--p) * 100%));
  }

  .skill__fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(var(--p) * 100%);
    height: 3px;
    background: var(--app);
  }

  .skill__needle {
    position: absolute;
    bottom: 0;
    left: calc(var(--p) * 100%);
    width: 2px;
    height: 18px;
    margin-left: -1px;
    background: var(--app);
    box-shadow: 0 0 6px var(--app);
  }

  /* Percentage in a solid category chip (black text passes AA on every vivid fill). */
  .skill__readout {
    flex-shrink: 0;
    padding: 4px 6px;
    background: var(--app);
    color: #000;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 39.999rem) {
    .skill.cell-pad {
      padding: 20px 16px;
    }

    .skill__top {
      flex-wrap: wrap-reverse;
      gap: 8px;
    }

    .skill__heading {
      gap: 8px;
      margin-top: 16px;
    }

    .skill__heading :global(.skill__logo) {
      margin-top: 0;
      font-size: 18px;
    }

    .skill__name.title-feature {
      font-size: 1.125rem;
      line-height: 1.5rem;
    }

    .skill__meter {
      gap: 10px;
      padding-top: 20px;
    }
  }
</style>
