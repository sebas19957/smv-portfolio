---
/**
 * Detail content of one project, rendered inside a <template> and mounted into the project
 * sheet on demand. The media block follows the entry's `kind`: web (hero + gallery), mobile
 * (phone screens) or backend (one or two images, text first).
 */
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  STACK_ORDER,
  type EcosystemText,
  type Locale,
  type ProjectDetailCopy,
  type ProjectEntry,
  type ProjectText,
} from '../../i18n';
import Button from '../../shared/ui/Button.astro';
import Icon from '../../shared/ui/Icon.astro';
import MediaPlaceholder from '../../shared/ui/MediaPlaceholder.astro';
import TechChip from '../../shared/ui/TechChip.astro';
import { detailShots, PLACEHOLDER_SLOTS, type ProjectMedia, type ProjectShot } from './project-media';
import { toChip } from './project-stack';

interface Props {
  index: string;
  locale: Locale;
  entry: ProjectEntry;
  text: ProjectText;
  media: ProjectMedia;
  labels: ProjectDetailCopy & { category: string; demo: string; site: string; code: string; newTab: string };
  /** Other entries of the same product (front ↔ back). */
  related: readonly { slug: string; title: string; part: string }[];
  /** Shared overview of the product, when it has several parts. */
  ecosystem?: EcosystemText | undefined;
}

const { index, locale, entry, text, media, labels, related, ecosystem } = Astro.props;
const titleId = `project-title-${entry.slug}`;
const ecosystemId = `project-ecosystem-${entry.slug}`;
const title = `${text.title.base}${text.title.accent}`;
const stackGroups = STACK_ORDER.flatMap((group) => {
  const refs = entry.stack[group];
  if (!refs?.length) return [];
  return [{ group, label: labels.stackGroups[group], items: refs.map(toChip) }];
});

// Media per template: the card image leads (web hero), then the gallery; backend shows two at most.
const kind = entry.kind;
const showKind = !labels.parts[entry.part].toLowerCase().includes(labels.kinds[kind].toLowerCase());
const shots = detailShots(media, kind);
const limited: ProjectShot[] = kind === 'backend' ? shots.slice(0, 2) : shots;
// Placeholders keep each template's minimum layout until the owner adds more images.
const galleryShots = kind === 'web' ? limited.slice(1) : limited;
const placeholderCount =
  kind === 'web'
    ? Math.max(0, PLACEHOLDER_SLOTS.web - 1 - galleryShots.length)
    : Math.max(0, PLACEHOLDER_SLOTS[kind] - limited.length);
const placeholders = Array.from({ length: placeholderCount }, (_, i) =>
  String((kind === 'web' ? galleryShots.length + 2 : limited.length + 1) + i).padStart(2, '0'),
);
// Thumbnail rows: three columns, or two when that leaves no orphan (2, 4, 8 … cells).
const galleryCells = galleryShots.length + placeholderCount;
const twoColumns = galleryCells % 3 !== 0 && galleryCells % 2 === 0;

// Large lightbox renditions (never upscaled).
const full = await Promise.all(
  limited.map(({ image }) => getImage({ src: image, width: Math.min(image.width, 2200), format: 'webp', quality: 82 })),
);
const plainTitle = title.replaceAll('\u00ad', '');
const captionOf = (shot: ProjectShot) => entry.captions?.[shot.key]?.[locale] ?? '';
const shotAlt = (i: number) => {
  const caption = captionOf(limited[i]);
  return `${plainTitle} — ${caption || String(i + 1).padStart(2, '0')}`;
};
const sizesFor = (role: 'hero' | 'thumb' | 'phone' | 'diagram') =>
  ({
    hero: '(min-width: 1280px) 1196px, calc(100vw - 48px)',
    thumb: '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw',
    phone: '240px',
    diagram: '(min-width: 1024px) 760px, calc(100vw - 48px)',
  })[role];
const widthsFor = (image: ImageMetadata, candidates: number[]) => [
  ...new Set(candidates.filter((w) => w < image.width).concat(Math.min(image.width, Math.max(...candidates)))),
];
---

<article class:list={['detail', `accent-${entry.accent}`]} data-detail-slug={entry.slug} data-title-id={titleId}>
  <header class="detail__head">
    <div class="detail__tags">
      <span class="hud-label num-badge">{index}</span>
      <span class="chip" data-tone="status">{labels.parts[entry.part]}</span>
      {showKind && <span class="chip">{labels.kinds[kind]}</span>}
      <span class="hud-label text-faint">{labels.category}</span>
      {
        entry.team && (
          <span class="hud-label detail__team">
            <Icon name="users" size={14} />
            {labels.team[entry.team]}
          </span>
        )
      }
    </div>
    <h2 id={titleId} class="heading-xl detail__title">
      {text.title.base}<span class="accent-word">{text.title.accent}</span>
    </h2>
    {text.summary !== text.overview && <p class="lead detail__lead">{text.summary}</p>}
    <div class="detail__actions">
      {
        entry.links?.live && (
          <Button href={entry.links.live} variant="primary" size="lg" icon="arrow-up-right" external>
            {labels.demo}
            <span class="sr-only">{labels.newTab}</span>
          </Button>
        )
      }
      {
        entry.links?.site && (
          <Button
            href={entry.links.site}
            variant={entry.links.live ? 'secondary' : 'primary'}
            size="lg"
            icon="globe"
            external
          >
            {labels.site}
            <span class="sr-only">{labels.newTab}</span>
          </Button>
        )
      }
      {
        entry.links?.repo && (
          <Button href={entry.links.repo} variant="secondary" size="lg" icon="github" external>
            {labels.code}
            <span class="sr-only">{labels.newTab}</span>
          </Button>
        )
      }
      {
        related.map((item) => (
          <button type="button" class="detail__related" data-project-open={item.slug}>
            <span class="hud-label text-faint">{labels.related}</span>
            <span class="detail__related-title">
              {item.title}
              {!item.title.toLowerCase().endsWith(item.part.toLowerCase()) && (
                <span class="text-faint">{` · ${item.part}`}</span>
              )}
            </span>
            <span class="detail__related-arrow" aria-hidden="true">→</span>
          </button>
        ))
      }
    </div>
  </header>

  <section class:list={['detail__media', `detail__media--${kind}`]} aria-label={labels.media}>
    {
      kind === 'web' && (
        <>
          <div class="detail__hero">
            {limited[0] ? (
              <button type="button" class="detail__shot" data-lightbox={full[0].src} data-lightbox-alt={shotAlt(0)} data-lightbox-caption={captionOf(limited[0])} aria-label={`${labels.openImage}: ${shotAlt(0)}`}>
                <Picture src={limited[0].image} alt={shotAlt(0)} widths={widthsFor(limited[0].image, [640, 960, 1280, 1600, 2000])} sizes={sizesFor('hero')} formats={['avif', 'webp']} fallbackFormat="webp" quality={80} loading="lazy" decoding="async" class="detail__img" />
              </button>
            ) : (
              <MediaPlaceholder label={labels.imageSoon} index="01" />
            )}
          </div>
          <div class:list={['detail__gallery', twoColumns && 'detail__gallery--2']}>
            {galleryShots.map((shot, i) => (
              <button type="button" class="detail__shot" data-lightbox={full[i + 1].src} data-lightbox-alt={shotAlt(i + 1)} data-lightbox-caption={captionOf(shot)} aria-label={`${labels.openImage}: ${shotAlt(i + 1)}`}>
                <Picture src={shot.image} alt={shotAlt(i + 1)} widths={widthsFor(shot.image, [400, 640, 800, 1200])} sizes={sizesFor('thumb')} formats={['avif', 'webp']} fallbackFormat="webp" quality={78} loading="lazy" decoding="async" class="detail__img" />
              </button>
            ))}
            {placeholders.map((slot) => (
              <div class="detail__slot">
                <MediaPlaceholder label={labels.imageSoon} index={slot} />
              </div>
            ))}
          </div>
        </>
      )
    }
    {
      kind === 'mobile' && (
        <div class="detail__phones" data-lenis-prevent>
          {limited.map((shot, i) => (
            <button type="button" class="detail__phone" data-lightbox={full[i].src} data-lightbox-alt={shotAlt(i)} data-lightbox-caption={captionOf(shot)} aria-label={`${labels.openImage}: ${shotAlt(i)}`}>
              <span class="detail__phone-screen">
                <Picture src={shot.image} alt={shotAlt(i)} widths={widthsFor(shot.image, [240, 480, 720])} sizes={sizesFor('phone')} formats={['avif', 'webp']} fallbackFormat="webp" quality={80} loading="lazy" decoding="async" class="detail__img" />
              </span>
            </button>
          ))}
          {placeholders.map((slot) => (
            <div class="detail__phone">
              <span class="detail__phone-screen">
                <MediaPlaceholder label={labels.imageSoon} index={slot} />
              </span>
            </div>
          ))}
        </div>
      )
    }
    {
      kind === 'backend' && (
        <div class="detail__diagrams">
          {limited.map((shot, i) => (
            <button type="button" class="detail__shot detail__diagram" data-lightbox={full[i].src} data-lightbox-alt={shotAlt(i)} data-lightbox-caption={captionOf(shot)} aria-label={`${labels.openImage}: ${shotAlt(i)}`}>
              <Picture src={shot.image} alt={shotAlt(i)} widths={widthsFor(shot.image, [640, 960, 1400])} sizes={sizesFor('diagram')} formats={['avif', 'webp']} fallbackFormat="webp" quality={82} loading="lazy" decoding="async" class="detail__img detail__img--contain" />
            </button>
          ))}
          {placeholders.map((slot) => (
            <div class="detail__diagram">
              <MediaPlaceholder label={labels.imageSoon} index={slot} />
            </div>
          ))}
        </div>
      )
    }
  </section>

  <div class="hairline-grid detail__body">
    <div class="detail__main">
      <section class="detail__block">
        <h3 class="hud-label detail__label">{labels.overview}</h3>
        <p class="detail__text">{text.overview}</p>
      </section>
      {
        text.architecture && (
          <section class="detail__block">
            <h3 class="hud-label detail__label">{labels.architecture}</h3>
            <p class="detail__text">{text.architecture}</p>
          </section>
        )
      }
      {
        text.highlights.length > 0 && (
          <section class="detail__block">
            <h3 class="hud-label detail__label">{labels.highlights}</h3>
            <ul class="detail__list">
              {text.highlights.map((item) => (
                <li class="detail__item">{item}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
    <aside class="detail__stack" aria-label={labels.stack}>
      <h3 class="hud-label detail__label">{labels.stack}</h3>
      {
        stackGroups.map((group) => (
          <div class="detail__group">
            <p class="hud-label text-faint">{group.label}</p>
            <div class="detail__chips">
              {group.items.map((item) => (
                <TechChip label={item.label} tech={item.tech} size="md" />
              ))}
            </div>
          </div>
        ))
      }
    </aside>
  </div>

  {
    ecosystem && (
      <section class="detail__eco" aria-labelledby={ecosystemId}>
        <div class="detail__eco-head">
          <h3 class="hud-label detail__label">{labels.ecosystem}</h3>
          <p id={ecosystemId} class="title-card detail__eco-title">
            {ecosystem.title}
          </p>
          <p class="detail__text">{ecosystem.overview}</p>
        </div>
        <dl class="hairline-grid detail__eco-grid">
          {ecosystem.rows.map((row) => (
            <div class="detail__eco-row">
              <dt class="hud-label detail__eco-key">{row.label}</dt>
              <dd class="detail__eco-value">{row.text}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</article>

<style>
  .detail {
    --pad: 24px;
  }

  .detail__head {
    padding: 40px var(--pad) 32px;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .detail__team {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--app-ink);
    font-weight: 700;
  }

  .detail__title {
    margin-top: 20px;
    max-width: 56rem;
    text-wrap: balance;
  }

  .detail__lead {
    margin-top: 16px;
  }

  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
    margin-top: 28px;
  }

  /* Front ↔ back link: an outlined cell that inverts on hover, like the reference's secondary. */
  .detail__related {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 6px 16px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink);
    text-align: left;
    transition:
      background-color 0.12s linear,
      color 0.12s linear;
  }

  .detail__related:hover {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .detail__related:hover .text-faint {
    color: inherit;
  }

  .detail__related-title {
    font-family: var(--font-display);
    font-weight: 620;
    font-stretch: 118%;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .detail__related-arrow {
    font-family: var(--font-mono);
  }

  /* ---------- Media ---------- */
  .detail__media {
    border-top: 1px solid var(--line);
    padding: var(--pad);
    background: color-mix(in srgb, var(--bg-sunken) 45%, var(--bg));
  }

  .detail__shot {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-sunken);
    cursor: zoom-in;
  }

  .detail__shot :global(picture) {
    position: absolute;
    inset: 0;
  }

  .detail :global(.detail__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 500ms var(--ease-out);
  }

  .detail :global(.detail__img--contain) {
    object-fit: contain;
    object-position: center;
  }

  .detail__shot:hover :global(.detail__img) {
    transform: scale(1.02);
  }

  .detail__hero {
    aspect-ratio: 16 / 10;
  }

  .detail__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 12px;
  }

  .detail__gallery > * {
    aspect-ratio: 16 / 10;
  }

  /* Phone screens (≈9:19.5) in hairline device frames, scrolled sideways. */
  .detail__phones {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .detail__phone {
    position: relative;
    flex: 0 0 auto;
    width: min(240px, 62vw);
    padding: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 34px;
    background: var(--bg);
    scroll-snap-align: start;
  }

  button.detail__phone {
    cursor: zoom-in;
  }

  .detail__phone::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 50%;
    z-index: 2;
    width: 54px;
    height: 5px;
    border-radius: 3px;
    background: var(--line-strong);
    transform: translateX(-50%);
  }

  .detail__phone-screen {
    position: relative;
    display: block;
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 25px;
    background: var(--bg-sunken);
  }

  .detail__phone-screen :global(picture) {
    position: absolute;
    inset: 0;
  }

  .detail__phone-screen :global(.placeholder) {
    border: 0;
  }

  .detail__diagrams {
    display: grid;
    gap: 12px;
  }

  .detail__diagram {
    aspect-ratio: 16 / 10;
    background: var(--bg-raised);
  }

  /* ---------- Body ---------- */
  .detail__body {
    border-top: 1px solid var(--line);
  }

  .detail__main,
  .detail__stack {
    padding: 32px var(--pad);
  }

  .detail__block + .detail__block {
    margin-top: 32px;
  }

  .detail__label {
    color: var(--faint);
    font-weight: 700;
  }

  .detail__text {
    max-width: 44rem;
    margin-top: 12px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .detail__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }

  .detail__item {
    position: relative;
    max-width: 44rem;
    padding-left: 22px;
    line-height: 1.625;
    color: var(--muted);
  }

  .detail__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8125em;
    width: 11px;
    height: 1px;
    background: var(--app);
  }

  .detail__group {
    margin-top: 20px;
  }

  .detail__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  /* ---------- Ecosystem (shared by every part of a product) ---------- */
  .detail__eco {
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-sunken) 45%, var(--bg));
  }

  .detail__eco-head {
    position: relative;
    padding: 32px var(--pad) 28px;
  }

  /* Item-colored tick that ties the shared block to the product. */
  .detail__eco-head::before {
    content: '';
    position: absolute;
    left: 0;
    top: 32px;
    width: 3px;
    height: 18px;
    background: var(--app);
  }

  .detail__eco-title {
    margin-top: 12px;
    font-size: 1.5rem;
  }

  .detail__eco-grid {
    border-top: 1px solid var(--line);
  }

  .detail__eco-row {
    padding: 20px var(--pad) 24px;
  }

  /* An odd last row spans the full width (no empty hairline cell). */
  .detail__eco-row:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .detail__eco-key {
    color: var(--app-ink);
    font-weight: 700;
  }

  .detail__eco-value {
    margin-top: 8px;
    max-width: 44rem;
    line-height: 1.625;
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .detail__gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .detail__gallery--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .detail__eco-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .detail {
      --pad: 40px;
    }

    .detail__head {
      padding-top: 56px;
    }

    .detail__diagrams {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .detail__body {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }
  }
</style>
