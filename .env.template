# Server-side only, read at runtime by the Node server (never inlined into the build).
# SMTP: 587 uses STARTTLS, 465 uses implicit TLS. EMAIL_FROM falls back to EMAIL_USER.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_RECEIVER=
# Rate limiting (3 messages per IP per 24h). If unset or unreachable, the form still sends.
REDIS_URL=
